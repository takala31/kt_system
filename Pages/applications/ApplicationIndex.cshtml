@page
@model kt_system.Pages.Applications.ApplicationIndexModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Applications</h3>
    <a asp-page="/Applications/ApplicationPage" class="btn btn-primary" asp-route-loadsample="true" asp-route-mode="New">New Application</a>
</div>

@if (string.IsNullOrEmpty(Model.Stage) || Model.Stage == "All")
{
    <h6>All Applications</h6>
}
else
{
    <h6>@Model.Stage Applications</h6>
}

<!-- stages breakdown dashboard-->
<div class="row row-cols-7 g-3">
    <div class="col">
        <a asp-page="/Applications/ApplicationIndex" asp-route-stagePassed="All" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>AllCount</h6>
                    <h2>@Model.AllCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Applications/ApplicationIndex" asp-route-stagePassed="Lead" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>Leads</h6>
                    <h2>@Model.LeadCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Applications/ApplicationIndex" asp-route-stagePassed="OnProgress" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>On Progress</h6>
                    <h2>@Model.OnProgressCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Applications/ApplicationIndex" asp-route-stagePassed="Approved" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>Approved</h6>
                    <h2>@Model.ApprovedCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Applications/ApplicationIndex" asp-route-stagePassed="Rejected" class="text-decoration-none">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h6>Rejected</h6>
                    <h2>@Model.RejectedCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Applications/ApplicationIndex" asp-route-stagePassed="DDEQC" class="text-decoration-none">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h6>DDEQC</h6>
                    <h2>@Model.DDEQCCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Applications/ApplicationIndex" asp-route-stagePassed="End" class="text-decoration-none">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h6>End</h6>
                    <h2>@Model.EndCount</h2>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Search form -->
<form method="get">
    <div class="row mb-2 mt-1">
        <div class="col-md-12">
            <div class="input-group input-group-sm">

                <input type="text"
                       name="searchText"
                       value="@Model.SearchText"
                       class="form-control"
                       placeholder="Search application no, customer, employer..." />

                <input type="hidden"
                       name="stagePassed"
                       value="@Model.Stage" />

                <button type="submit" class="btn btn-secondary">
                    Search
                </button>

            </div>
        </div>
    </div>
</form>

<div class="container-fluid mt-3">
    <div class="table-responsive table-container">
        <table class="table table-striped table-sm text-nowrap table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Application No</th>
                    <th>Customer</th>
                    <th>Nationality</th>
                    <th>Employer</th>
                    <th>Product</th>
                    <th>Original Price</th>
                    <th>Downpayment</th>
                    <th>NFA</th>
                    <th>Profit Rate</th>
                    <th>User</th>
                    <th>Stage</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model.Apps)
                {
                    <tr>
                        <td>@row["AppID"]</td>
                        <td>@row["AppID_usr"]</td>

                        <td>
                            @row["FirstName"]
                            @row["LastName"]
                        </td>

                        <td>@row["Nationality"]</td>

                        <td>@row["Employer"]</td>

                        <td>@row["AppProduct"]</td>

                        <td>@Convert.ToDecimal(row["OriginalPrice"]).ToString("N0")</td>
                        <td>@Convert.ToDecimal(row["Downpayment"]).ToString("N0")</td>
                        <td>@Convert.ToDecimal(row["NFA"]).ToString("N0")</td>

                        <td>@row["ProfitRate"]</td>
                        <td>@row["CreatedBy"]</td>

                        <td>@row["Stage"]</td>

                        <td>
                            <a asp-page="ApplicationPage" asp-route-id="@row["AppID"]" asp-route-mode="Edit">Edit</a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>























