@page
@model kt_system.Pages.Applications.CreateModel

<div class="container mt-3">

    <h2>Create Application</h2>

    <form method="post">
        <div class="mb-3">
        </div>


        <!-- ===================================================== -->
        <!-- Application -->
        <!-- ===================================================== -->

        <div class="card mb-3">

            <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between" style="white-space: nowrap; padding: 0.5rem 1rem;">
                <span>
                    Application ---------------------------------------------------------------------------
                    <button type="submit" class="btn btn-primary btn-sm flex-shrink-0" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">Save New</button>
                    <a asp-page="./Index" class="btn btn-secondary btn-sm flex-shrink-0" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">Back to List</a>
                </span>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <label asp-for="AppID_usr" class="col-sm-3 col-form-label">Application No</label>
                    <div class="col-sm-4"> <input asp-for="AppID_usr" class="form-control" readonly style="background-color: #fff; color: #212529; opacity: 1;" /></div>
                </div>

                <div class="row mb-3">
                    <label asp-for="AppDate_usr" class="col-sm-3 col-form-label">Application Date</label>
                    <div class="col-sm-4"> <input asp-for="AppDate_usr" type="date" class="form-control" /></div>
                </div>

                <div class="row mb-3">
                    <label asp-for="AppProduct" class="col-sm-3 col-form-label">Product</label>
                    <div class="col-sm-4">
                        <select asp-for="AppProduct" class="form-select">
                            <option value="">-- Select Product --</option>
                            @foreach (var p in Model.drpProducts)
                            {
                                <option value="@p["ProductCode"]">
                                    @p["ProductCode"]
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Stage" class="col-sm-3 col-form-label">Stage</label>
                    <div class="col-sm-4">
                        <select asp-for="Stage" class="form-select">
                            <option value="">-- Select Stage--</option>
                            @foreach (var p in Model.drpStages)
                            {
                                <option value="@p["Stage"]">
                                    @p["Stage"]
                                </option>
                            }
                        </select>
                    </div>
                </div>

            </div>
        </div>

