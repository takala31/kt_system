            <div class="card-body">

                <div class="row mb-3">
                    <label asp-for="OriginalPrice" class="col-sm-3 col-form-label">Original Price</label>
                    <div class="col-sm-4">
                        <input asp-for="OriginalPrice" id="OriginalPrice" type="number" step="0.01" class="form-control text-end" />
                    </div>

                    <label asp-for="Downpayment" class="col-sm-2 col-form-label">Downpayment</label>
                    <div class="col-sm-3">
                        <input asp-for="Downpayment" id="Downpayment" type="number" step="0.01" class="form-control text-end" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="NFA" class="col-sm-3 col-form-label">NFA</label>
                    <div class="col-sm-4">
                        @* <input asp-for="NFA" type="number" step="0.01" class="form-control text-end" /> *@
                        <input asp-for="NFA" class="form-control text-end" type="number" step="0.01" readonly />
                    </div>

                    <label asp-for="ProfitRate" class="col-sm-2 col-form-label">Profit Rate (%)</label>
                    <div class="col-sm-3">
                        <input asp-for="ProfitRate" type="number" step="0.01" class="form-control text-end" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Tenor" class="col-sm-3 col-form-label">Tenor (Months)</label>
                    <div class="col-sm-4">
                        <input asp-for="Tenor" type="number" step="0.01" class="form-control text-end" />
                    </div>

                    <label asp-for="DSR" class="col-sm-2 col-form-label">DSR (%)</label>
                    <div class="col-sm-3">
                        <input asp-for="DSR" type="number" step="0.01" class="form-control text-end" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="SalesName" class="col-sm-3 col-form-label">Sales Name</label>
                    <div class="col-sm-9">
                        <input asp-for="SalesName" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Remarks" class="col-sm-3 col-form-label">Remarks</label>
                    <div class="col-sm-9">
                        <textarea asp-for="Remarks"
                                  rows="4"
                                  class="form-control"></textarea>
                    </div>
