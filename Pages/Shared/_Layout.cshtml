<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - kt_system</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/kt_system.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            @* <div class="col-md-2 bg-dark text-white min-vh-100"> *@
            <div class="col-md-2 sidebar text-white">
                <div class="p-3">
                    <h4>KT System</h4>
                    <hr />

                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-page="/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-page="/Applications/Index">Applications</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link sidebar-link"asp-page="/Customers/Index">Customers</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-page="/Properties/Index">Properties</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-page="/GeneralCodes/Index">General Codes</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link sidebar-link" href="https://ktblog2-j0kdk.sevalla.page/" target="_blank" rel="noopener noreferrer">KT Blog</a>
                        </li>

                    </ul>
                </div>

            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                @RenderBody()
            </div>

        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


