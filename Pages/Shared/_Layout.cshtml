<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - kt_system</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>



    @{
          var LoggedName = Context.Session.GetString("FullName");
          var LoggedRole = Context.Session.GetString("UserRole");
    }

<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar bg- text-white mt-4">
                <div class="p-3">
                    <h3>KT System<span class="text-yellow" style="font-size:.6rem;"> Version 1.0</span> </h3>

                    @if (string.IsNullOrEmpty(LoggedName))
                    {
                        <span class="text-white" style="font-size:.6rem;">Not loggedin</span>
                    }
                    else
                    {
                        <span class="text-white" style="font-size:.6rem;">Welcome, @LoggedName (@LoggedRole)</span>
                    }

                    @* <span class="text-white" style="font-size:.6rem;">Welcome, @LoggedName - @LoggedRole |Version 1.0</span> *@
                    @* <span class="text-white" style="font-size:.6rem;">Welcome, @LoggedName - @LoggedRole<br />Version 1.0.0</span> *@
                    @* <span class="text-white" style="font-size: .6rem;">Welcome, @LoggedName - @LoggedRole | Version 1.0.0 </span> *@
                    <hr />
                    <ul class="nav flex-column">
                        <li class="nav-item">                                           
                            <a class="nav-link sidebar-link" asp-page="/Applications/ApplicationIndex">Applications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-page="/Customers/CustomerIndex">Customers</a>
                        </li>


                        @if (LoggedRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-page="/Users/UserIndex">Users</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-page="/GeneralCodes/Index">General Codes</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-page="/Properties/Index">Properties</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-page="/Index">Welcome Page</a>
                        </li>

                        @if (String.IsNullOrEmpty(Context.Session.GetString("UserRole")))
                        {
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-page="/Account/Login">Login</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-page="/Account/Logout">Logout</a>
                            </li>
                        }

                        <!-- Bootstrap with sub-menu -->
                        <li class="nav-item">
                            <div class="d-flex align-items-center justify-content-between">
                                <a class="nav-link sidebar-link flex-grow-1" href="#">Usefull Links</a>
                                <a class="nav-link sidebar-link" data-bs-toggle="collapse" href="#bootstrapMenu" role="button" aria-expanded="false" aria-controls="bootstrapMenu" title="Show more">&#9662;</a>
                            </div>

                            <div class="collapse" id="bootstrapMenu">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item">
                                        <a class="nav-link sidebar-link" href="https://getbootstrap.com/docs/6.0/layout/grid/" target="_blank" rel="noopener noreferrer">Bootstrap</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link sidebar-link" href="https://htmlcolors.com/google-color-picker" target="_blank" rel="noopener noreferrer">Google Colors</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link sidebar-link" href="https://fonts.google.com/" target="_blank" rel="noopener noreferrer">Google Fonts</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link sidebar-link" href="https://ktblog2-j0kdk.sevalla.page/my_career_bs.html" target="_blank" rel="noopener noreferrer">KT Blog</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link sidebar-link" href="https://aqili2.azurewebsites.net/" target="_blank" rel="noopener noreferrer">Aili2</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link sidebar-link" href="https://portal.azure.com/#home/" target="_blank" rel="noopener noreferrer">azure sql</a>
                                    </li>
                                </ul>                               

                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                @RenderBody()
            </div>

        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

