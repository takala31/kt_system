@page
@model kt_system.Pages.Users.UserIndexModel

<div class="d-flex justify-content-between align-items-center mb-3">

    @* <h2 class="mb-0">Applications</h2> *@
    <h3 class="mb-0">Users</h3>
    @* <a asp-page="Create" class="btn btn-primary" asp-route-loadsample="true">New Application</a> *@
    <a asp-page="/Users/UserPage" class="btn btn-primary" asp-route-loadsample="true" asp-route-mode="New">New User</a>

</div>

@if (string.IsNullOrEmpty(Model.Status) || Model.Status== "All")
{
    <h6>All Users</h6>
}
else
{
    <h6>@Model.Status Users</h6>
}


<!-- stages breakdown dashboard-->
<div class="row mt-4 ms-2">

    <div class="col-md-2">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="All" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>AllCount</h6>
                    <h2>@Model.AllCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-2">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="Active" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>Active</h6>
                    <h2>@Model.ActiveCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-2">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="Resigned" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>Resigned</h6>
                    <h2>@Model.ResignedCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-2">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="Terminated" class="text-decoration-none">
            <div class="card text-bg-primary dashboard-card">
                <div class="card-body">
                    <h6>Terminated</h6>
                    <h2>@Model.TerminatedCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-2">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="OnHold" class="text-decoration-none">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h6>OnHold</h6>
                    <h2>@Model.OnHoldCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-2">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="InActive" class="text-decoration-none">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h6>InActive</h6>
                    <h2>@Model.InActiveCount</h2>
                </div>
            </div>
        </a>
    </div>

</div>

<!-- Search form -->
<form method="get">
    <div class="row mb-1 mt-1 ms-2">
        <div class="col-md-12">
            <div class="input-group input-group-sm">

                <input type="text"
                       name="searchText"
                       value="@Model.SearchText"
                       class="form-control"
                       placeholder="Search application no, customer, employer..." />

                <input type="hidden"
                       name="statusPassed"
                       value="@Model.Status" />

                <button type="submit" class="btn btn-secondary">
                    Search
                </button>

            </div>
        </div>
    </div>
</form>


<!--
       [UserID]
      ,[UserName]
      ,[PasswordHash]
      ,[FullName]
      ,[UserManager]
      ,[UserRole]
      ,[Email]
      ,[UserStatus]
      ,[CreatedBy]
      ,[CreatedOn]
      ,[LastUpdatedBy]
      ,[LastUpdatedOn]
      ,[LastLogin]
      ,[Remarks]

-->

<div class="container-fluid mt-3">
    <div class="table-responsive table-container">
        <table class="table table-striped table-sm text-nowrap table-hover">
            <thead>
                <tr>
                    <th>UserID</th>
                    <th>User Name</th>
                    <th>FullName</th>
                    <th>Manager</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Remarks</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model.users)
                {
                    <tr>
                        <td>@row["UserID"]</td>
                        <td>@row["UserName"]</td>

                        <td>@row["FullName"]</td>

                        <td>@row["UserManager"]</td>

                        <td>@row["UserRole"]</td>

                        <td>@row["UserStatus"]</td>
                        <td>@row["Remarks"]</td>

                        <td>
                            @* <a asp-page="Edit" asp-route-id="@row["AppID"]">Edit</a> *@
                            <a asp-page="UserPage" asp-route-id="@row["UserID"]" asp-route-mode="Edit">Edit</a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>























