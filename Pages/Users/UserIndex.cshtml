<!-- stages breakdown dashboard-->
<div class="row row-cols-7 g-3">
    <div class="col">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="All" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>All Users</h6>
                    <h2>@Model.AllCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="Active" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Active</h6>
                    <h2>@Model.ActiveCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="Resigned" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Resigned</h6>
                    <h2>@Model.ResignedCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="Terminated" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Terminated</h6>
                    <h2>@Model.TerminatedCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="OnHold" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>OnHold</h6>
                    <h2>@Model.OnHoldCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="InActive" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>InActive</h6>
                    <h2>@Model.InActiveCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Users/UserIndex" asp-route-statusPassed="Suspended" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Suspended</h6>
                    <h2>@Model.SuspendedCount</h2>
                </div>
            </div>
        </a>
    </div>


</div>

<!-- Search form -->
<form method="get">
    <div class="row mb-2 mt-1">

        <div class="col-md-3">
            <div class="input-group input-group-sm">
                <input type="text" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Search application no, customer, employer..." />
                <input type="hidden" name="statusPassed" value="@Model.Status" />
                &nbsp
                <button type="submit" class="btn btn-secondary">Search</button>
                &nbsp
                <a asp-page="/Users/UserIndex" class="btn btn-outline-secondary">x</a>
            </div>
        </div>

        <div class="col-md-9 text-end alert-secondary">
            <span>Found: @Model.users.Count users</span>
        </div>

    </div>
</form>

<div class="container-fluid mt-3">
    <div class="table-responsive table-container">
        <table class="table table-striped table-sm text-nowrap table-hover">
            <thead>
                <tr>
                    <th>UserID</th>
                    <th>User Name</th>
                    <th>FullName</th>
                    <th>Manager</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Remarks</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model.users)
                {
                    <tr>
                        <td>@row["UserID"]</td>
                        <td>@row["UserName"]</td>
                        <td>@row["FullName"]</td>
                        <td>@row["UserManager"]</td>
                        <td>@row["UserRole"]</td>
                        <td>@row["UserStatus"]</td>
                        <td>@row["Remarks"]</td>

                        <td><a asp-page="UserPage" asp-route-id="@row["UserID"]" asp-route-mode="Edit">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



<hr style="height: 3px; border: none; background:#000;" />

<div class="row mt-3">
    <div class="col-md-3">
        <h6 class="mt-4">Approved Monitor</h6>
        <div class="table-responsive table-container">
            <table class="table table-striped table-sm text-nowrap table-hover">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Total</th>
                        <th>Open</th>
                        <th>Approved %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in Model.dtPerformance.Rows)
                    {
                        <tr>
                            <td>@row["User"]</td>
                            <td>@row["TotalCases"]</td>
                            <td>@row["OpenCases"]</td>
                            <td>
                                @if (Convert.ToDecimal(row["ApprovalPct"]) >= 70)
                                {
                                    <span class="badge bg-success">
                                        @row["ApprovalPct"] %
                                    </span>
                                }
                                else if (Convert.ToDecimal(row["ApprovalPct"]) >= 50)
                                {
                                    <span class="badge bg-warning">
                                        @row["ApprovalPct"] %
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        @row["ApprovalPct"] %
                                    </span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-9">
        <h6 class="mt-4">Performance Matrix Detailed</h6>
        <div class="table-responsive table-container">
        <table class="table table-striped table-sm text-nowrap table-hover">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Total</th>
                    <th>Lead</th>
                    <th>DDEQC</th>
                    <th>OnProgress</th>
                    <th>Approved</th>
                    <th>Rejected</th>
                    <th>End</th>
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in Model.dtPerformance.Rows)
                {
                    <tr>
                        <td>@row["User"]</td>
                        <td>@row["TotalCases"]</td>
                        <td>@row["Lead"]</td>
                        <td>@row["DDEQC"]</td>
                        <td>@row["OnProgress"]</td>
                        <td>@row["Approved"]</td>
                        <td>@row["Rejected"]</td>
                        <td>@row["End"]</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

