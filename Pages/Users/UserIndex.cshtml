@model kt_system.Pages.Users.UserIndexModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Users</h3>
    <a asp-page="/Users/UserPage" class="btn btn-primary" asp-route-loadsample="true" asp-route-mode="New">New User</a>
</div>

