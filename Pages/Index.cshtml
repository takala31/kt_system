@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <title>Document</title>
</head>
<body>

    @if (Request.Query["login"] == "1")
    {
        <script>
            window.onload = function () {
                new bootstrap.Modal(
                    document.getElementById('loginModal')
                ).show();
            };
        </script>
    }

    <div class="card shadow-sm mb-3" style="background-color: #2f5c78;">
        <div class="card-body text-center pb-0">
            <h1 class="display-5 fw-bold text-white mb-0">KT System</h1>

            <p class="text-muted mb-0" style="font-size: .9rem; -webkit-text-fill-color: goldenrod;">Customer, Property & Finance Management Platform</p>
            <div class="mb-0">
                <a class="btn btn btn-outline-secondary btn-sm me-2" asp-page="/Applications/Create">New Application</a>
                <a class="btn btn-outline-secondary btn-sm me-2" asp-page="/Customers/Index">Customers</a>
                <a class="btn btn-outline-secondary btn-sm me-2" asp-page="/Properties/Index">Properties</a>
            </div>
            <div class="mb-0" style="display: flex; justify-content: space-between;">
                <span class="text-white" style="font-size: .6rem;">Welcome, @User.Identity?.Name | Version 1.0.0</span>
                @* <span><a href="https://ktblog2-j0kdk.sevalla.page/my_career_bs.html" style="font-size: .6rem"; target="_blank">Learn more about KT</a></span> *@
                <span>
                    @* <a href="https://ktblog2-j0kdk.sevalla.page/my_career_bs.html" target="_blank" style="font-size:.6rem; color:#ffffff;"> Learn more about KT</a> *@
                    @* <a asp-page="/Account/Login" target="_blank" style="font-size:.8rem; color:#ffffff;">Login</a> *@
                    @* <a asp-page="/Account/Login" target="_blank" style="font-size:.8rem; color:#ffffff;">Login</a> *@
                    <a href="#" data-bs-toggle="modal" style="font-size:.8rem; color:#ffffff;" data-bs-target="#loginModal">Login</a>
                </span>
            </div>
        </div>

    </div>

    @*  
        <a class="theme-secondary underline-offset-2 underline-20 hover:underline-100" asp-page="/Applications/Create">New Application</a>
        <a class="theme-secondary underline-offset-2 underline-20 hover:underline-100" asp-page="/Customers/Index">Customers</a>
        <a class="theme-secondary underline-offset-2 underline-20 hover:underline-100" asp-page="/Properties/Index">Properties</a>
     *@

    <div class="hero-image">
        <img src="images/stock-photo.jpg"
             alt="KT System"
             class="full-page-image" />

        <div class="hero-text">
            <h2>Customer, Property & Finance Management</h2>
            <p>One Platform. Complete Visibility.</p>
        </div>

    </div>

    <!-- Alert Message-->
    @if (TempData["alertMessage"] != null)
    {
        <div id="alertMessage" class="alert alert-@(TempData["alertColor"])">@Html.Raw(TempData["alertMessage"])</div>
        @* <div id="alertMessage" class="alert alert-success alert-dismissible">@TempData["alertMessage"]</div> *@
    }

    <!--Modal for login page-->
    <div class="modal fade" id="loginModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#2f5c78;color:white;">
                    <h5 class="modal-title">KT System Login</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <form method="post">

                        <div class="mb-3">
                            <label>User Name</label>
                            <input type="text" class="form-control" name="UserName">
                        </div>

                        <div class="mb-3">
                            <label>Password</label>
                            <input type="password" class="form-control" name="Password">
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Login</button>

                    </form>
                </div>
            </div>
        </div>
    </div>

</body>
</html>




<style>

    .full-page-image {
        width: 100%;
        height: 75vh;
        object-fit: cover;
        display: block;
        opacity: .75;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        box-shadow: 0 0 25px rgba(0,0,0,.15);
    }

    .hero-image {
        position: relative;
    }

    .hero-text {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: white;
        z-index: 10;
        text-shadow: 2px 2px 10px rgba(0,0,0,.75);
    }

        .hero-text h2 {
            font-size: 2.5rem;
            font-weight: 700;
        }

        .hero-text p {
            font-size: 1.2rem;
        }


    .modal-content {
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,.3);
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-body {
        padding: 30px;
    }
</style>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

