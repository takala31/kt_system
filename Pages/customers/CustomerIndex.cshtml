@page
@model kt_system.Pages.Customers.CustomerIndexModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Customers</h3>
    <a asp-page="/Customers/CustomerPage" class="btn btn-primary" asp-route-loadsample="true" asp-route-mode="New">New Customer</a>
</div>

@if (string.IsNullOrEmpty(Model.statusPassed2) || Model.statusPassed2 == "All")
{
    <h6>All Customers</h6>
}
else
{
    <h6>@Model.statusPassed2 Customers</h6>
}

<!-- Customer Status breakdown dashboard-->
<div class="row row-cols-7 g-3">
    <div class="col">
        <a asp-page="/customers/CustomerIndex" asp-route-statusPassed="All" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>AllCust</h6>
                    <h2>@Model.AllCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/customers/CustomerIndex" asp-route-statusPassed="Active" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Active</h6>
                    <h2>@Model.activeCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/customers/CustomerIndex" asp-route-statusPassed="inactive" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>InActive</h6>
                    <h2>@Model.inactiveCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/customers/CustomerIndex" asp-route-statusPassed="advocate" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Advocate</h6>
                    <h2>@Model.advocateCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/customers/CustomerIndex" asp-route-statusPassed="Prospect" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Prospect</h6>
                    <h2>@Model.prospectCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/customers/CustomerIndex" asp-route-statusPassed="qualified" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Qualified</h6>
                    <h2>@Model.qualifiedCount</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a asp-page="/customers/CustomerIndex" asp-route-statusPassed="repeat_customer" class="text-decoration-none">
            <div class="card text-bg-primary metric-card">
                <div class="card-body">
                    <h6>Repeat</h6>
                    <h2>@Model.repeat_customerCount</h2>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Search form -->
<form method="get">
    <div class="row mb-2 mt-1">

        <div class="col-md-3">
            <div class="input-group input-group-sm">
                <input type="text" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Search application no, customer, employer..." />
                <input type="hidden" name="statusPassed" value="@Model.statusPassed2" />
                <button type="submit" class="btn btn-secondary">Search</button>
                &nbsp
                <a asp-page="/Customers/CustomerIndex" class="btn btn-outline-secondary">x</a>
                &nbsp
            </div>
        </div>

        <div class="col-md-9 text-end alert-secondary">
            <span>Found: @Model.Customers.Count customers.</span>
        </div>
    </div>
</form>


