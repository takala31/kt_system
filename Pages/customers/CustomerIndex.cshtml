<div class="container-fluid mt-3">
    <div class="table-responsive table-container">
        <table class="table table-striped table-sm text-nowrap table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>AraName</th>
                    <th>DOB</th>
                    <th>Nationality</th>
                    <th>Mobile</th>
                    <th>Emirates ID</th>
                    <th>ID Expiry</th>
                    <th>Pass No</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var row in Model.Customers)
                {
                    <tr>
                        <td>@row["CustomerID"]</td>
                        <td>@row["FirstName"] @row["MiddleName"] @row["LastName"] </td>
                        <td>@row["AraName"]</td>
                        <td>@row["DOB"]</td>
                        <td>@row["Nationality"]</td>
                        <td>@row["Mobile"]</td>
                        <td>@row["EmiratesID"]</td>
                        <td>@row["EmiratesIDExpiry"]</td>
                        <td>@row["PassportNumber"]</td>
                        <td>@row["CustomerStatus"]</td>
                        <td>
                            <a asp-page="CustomerPage" asp-route-id="@row["CustomerID"]">Edit</a>
                            <a asp-page="Delete" asp-route-id="@row["CustomerID"]">Del</a>

                            @* <a asp-page="CustomerPage" asp-route-id="@row["CustomerID"]" class="btn btn-sm btn-outline-primary">Edit</a> *@
                            @* <a asp-page="Delete" asp-route-id="@row["CustomerID"]" class="btn btn-sm btn-outline-danger">Del</a> *@

                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>