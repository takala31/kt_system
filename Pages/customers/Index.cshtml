@page
@model kt_system.Pages.Customers.IndexModel

<h2>Customers</h2>

<p>
    <a asp-page="Create"
       class="btn btn-success">
        New Customer
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Nationality</th>
            <th>Mobile</th>
            <th>Email</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var row in Model.Customers)
        {
            <tr>
                <td>@row["CustomerID"]</td>

                <td>
                    @row["FirstName"]
                    @row["LastName"]
                </td>

                <td>@row["Nationality"]</td>
                <td>@row["Mobile"]</td>
                <td>@row["Email"]</td>
                <td>@row["CustomerStatus"]</td>

                <td>
                    <a asp-page="Edit" asp-route-id="@row["CustomerID"]" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@row["CustomerID"]" class="btn btn-sm btn-danger">Delete</a>
                    <!-- <a asp-page="Delete" asp-route-id="@row["CustomerID"]" class="btn btn-sm btn-danger">De-Activate</a> -->
                </td>
            </tr>
        }

    </tbody>
</table>